# ============================================================
# 環境變數範本（這個檔案「會」上傳到 GitHub，所以只放空白欄位，不放真的值）
# 使用方式：複製一份並改名為 .env.local，再填入你自己的值
# 部署到 Vercel 時：到 Project → Settings → Environment Variables，
#                  把下面每一行的 KEY 和 VALUE 填進去
# ============================================================

# Anthropic API 金鑰：https://platform.claude.com/
ANTHROPIC_API_KEY=

# 示範模式：true = 用假資料、不呼叫 Claude；false 或不填 = 使用真的 AI
DEMO_MODE=true
